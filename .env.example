# Local development only. Copy to .env and fill in real values; never commit .env.
# cp .env.example .env
#
# The editor (VS Code + TypeScript 7 native preview) reads DATABASE_URL from
# this file — it does not see your shell's exports. Without it, Reylo cannot
# type .sql imports and they show as "cannot find module".

# Migrated dev database via infra/compose.ports.yaml (user/db `feastjourney`).
DATABASE_URL=postgres://<username>:<password>@127.0.0.1:5433/feastjourney

# Public base URL of this deployment. Used for OAuth callbacks and email links.
BETTER_AUTH_URL=http://localhost:3000

# Session encryption secret. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Facebook Login (https://developers.facebook.com/apps).
# Valid OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=replace-with-facebook-app-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-app-secret

# SMTP for verification and password-reset email. Local development can point
# at Mailpit (`docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=feastjourney
SMTP_PASSWORD=local-only-smtp-password
EMAIL_FROM=FeastJourney <noreply@feastjourney.example>

# Optional overrides (defaults shown).
# DATABASE_POOL_MAX=10
# CORS_ORIGINS=
# TRUSTED_PROXIES=
# RATE_LIMIT_PUBLIC=60
# RATE_LIMIT_PUBLIC_WINDOW_S=60
# RATE_LIMIT_SEARCH=20
# RATE_LIMIT_SEARCH_WINDOW_S=60
# RATE_LIMIT_ADMIN=10
# RATE_LIMIT_ADMIN_WINDOW_S=60
# REQUEST_TIMEOUT_MS=15000

# Restaurant observations and server-side Frankfurter v2 reference FX.
# FX_ENDPOINT=https://api.frankfurter.dev/v2/
# FX_REFRESH_HOURS=24
# FX_MAX_AGE_HOURS=72
# RESTAURANT_REVIEW_DAYS=90

# Optional browser-visible style URL. Use a licensed provider and a
# public/referrer-restricted key. Without it, discovery keeps its list view.
# VITE_MAP_STYLE_URL=https://your-licensed-provider.example/style.json
#
# Optional Muse dish-ranking integration. When MODEL_API_KEY is unset, the
# recommendation endpoint serves the deterministic baseline and says so;
# nothing else changes and startup never depends on these values.
# RECOMMENDATION_PROVIDER=deterministic
# MODEL_API_KEY=
# MODEL_MODEL_ID=muse-spark-1.3
# MODEL_BASE_URL=https://api.meta.ai/v1
# MODEL_TIMEOUT_MS=15000
# MODEL_CANDIDATE_LIMIT=60
# MODEL_OUTPUT_LIMIT=10
