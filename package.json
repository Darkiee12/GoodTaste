{
  "name": "goodtaste",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "bun check --runExternalCode",
    "lint": "oxlint . --disable-nested-config --ignore-pattern 'repos/**' --max-warnings 0",
    "lint:fix": "oxlint . --disable-nested-config --ignore-pattern 'repos/**' --fix",
    "format": "oxfmt --check .",
    "fmt": "oxfmt .",
    "check-types": "tsc --noEmit --runExternalCode -p tsconfig.json",
    "check": "bun run format && bun run lint && bun run check-types"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/cli": "^0.1.22",
    "@reylosql/postgres": "^0.5.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "^7.1.0-beta",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reylo": "^0.5.0"
  }
}
