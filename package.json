{
  "name": "feastjourney",
  "type": "module",
  "private": true,
  "overrides": {
    "tinypool": "^2.2.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:node": "NITRO_PRESET=node_server vite build",
    "start": "bun .output/server/index.mjs",
    "start:node": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit --runExternalCode",
    "lint": "oxlint . --disable-nested-config --ignore-pattern 'repos/**' --max-warnings 0",
    "lint:fix": "oxlint . --disable-nested-config --ignore-pattern 'repos/**' --fix",
    "format": "oxfmt --check .",
    "format:check": "oxfmt --check .",
    "fmt": "oxfmt .",
    "check-types": "tsc --noEmit --runExternalCode -p tsconfig.json",
    "check": "bun run format && bun run lint && bun run check-types",
    "test": "bun test tests/",
    "audit": "bun run audit:dependencies && bun run audit:slop && bun run audit:react-doctor && bun run audit:react-compiler",
    "audit:dependencies": "bun audit",
    "audit:slop": "bunx aislop@0.18.1 ci",
    "audit:react-doctor": "bunx react-doctor@0.9.18 --no-supply-chain --no-score src",
    "audit:react-compiler": "bunx react-compiler-healthcheck@1.0.0 --src 'src/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@playwright/cli": "^0.1.22",
    "@reylosql/postgres": "0.6.0",
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "0.65.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "^3.9.10",
    "typescript": "^7.1.0-dev.20261026.1",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.14",
    "cn": "^0.5.0",
    "effect": "^4.0.6",
    "lucide-react": "^1.62.0",
    "maplibre-gl": "^6.16.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "reylo": "0.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  }
}
