# Production environment template. Copy to infra/.env.production and fill
# in REAL values (staging and production share names, never values).
# Real values live only in Dokploy service secrets / the GitHub `staging`
# environment — never in git, logs, or chat. See
# docs/infra/deployment-dokploy-azure.md and docs/infra/environment.md.
#
# Usage:
#   cp infra/.env.production.example infra/.env.production
#   docker compose --env-file infra/.env.production -f infra/compose.prod.yaml up -d

# --- Image: the CI-verified GHCR tag (never `latest`) ---
# Example: ghcr.io/darkiee12/feastjourney:sha-abc1234
APP_IMAGE=

# --- PostgreSQL bootstrap (migrator + database init only) ---
# The app NEVER receives these; it gets the derived app-role DATABASE_URL.
POSTGRES_USER=feastjourney
POSTGRES_DB=feastjourney
# Generate per environment. Keep free of URL-special characters (@ : /)
# or percent-encode them — the value is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=

# --- App identity and auth ---
# Exact public https origin, no trailing slash. OAuth redirect URIs derive
# from it: <origin>/api/auth/callback/{google,facebook} — register both
# exactly in the Google/Facebook consoles before first login.
BETTER_AUTH_URL=
# Session encryption secret. Generate with `openssl rand -base64 32` per
# environment. Rotation logs everyone out.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (signup verification, password reset; deliverability is a gate) ---
# Needs SPF + DKIM + DMARC on the sending domain. Test signup-verify and
# reset-password end to end on staging.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=FeastJourney <noreply@example.com>

# --- Reverse proxy / hardening ---
# REQUIRED behind Traefik/tunnel: the Traefik hop address/CIDR so rate
# limiting, audit logs, and Better Auth IP handling see real clients.
# Empty locally, exact in production.
TRUSTED_PROXIES=
# Small-VM starting points; tune on p95 evidence.
DATABASE_POOL_MAX=10
CORS_ORIGINS=
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_SEARCH=20
RATE_LIMIT_ADMIN=10
REQUEST_TIMEOUT_MS=15000
# Optional owner bootstrap: this address receives the owner role right
# after signup. Leave unset and grant ownership out of band with SQL.
OWNER_EMAIL=

# --- First-party object storage (Garage single-node, private buckets) ---
# Garage topology is single-node and NOT highly available: all objects live on
# the one labeled Swarm node (volumes garage_meta + garage_data). Losing that
# node without a tested backup loses objects. See
# docs/infra/object-storage.md (backup/restore, rotation, rollback).
#
# Bootstrap/admin credentials (Garage service only; NEVER give these to the
# app). Generated once per environment, stored as Dokploy secrets + offline
# sealed copy. Changing them after bootstrap does NOT rotate the running
# cluster: follow the rotation runbook instead of editing and redeploying.
# GARAGE_RPC_SECRET: 32 random bytes as 64 hex chars (`openssl rand -hex 32`).
# GARAGE_BOOTSTRAP_*: `GK` + 32 hex (`openssl rand -hex 16` prefixed with GK)
#   for the access-key ID and 64 hex (`openssl rand -hex 32`) for the secret.
#   These create the initial bucket + bootstrap key via --default-bucket.
GARAGE_RPC_SECRET=
GARAGE_BOOTSTRAP_ACCESS_KEY=
GARAGE_BOOTSTRAP_SECRET_KEY=
#
# App S3 credentials (LEAST PRIVILEGE, app service only). Provisioned AFTER
# first Garage deploy via infra/scripts/garage-provision.sh, which creates a
# `feastjourney-app` key with read+write (no --owner) on the private bucket.
# The app never receives GARAGE_RPC_SECRET or bootstrap keys. Rotate via the
# same script (create new key -> allow -> update Dokploy secret -> verify ->
# deny/delete old); existing objects and the bucket survive rotation.
S3_REGION=garage
S3_BUCKET_PRIVATE=feastjourney-private
# Keep MEDIA identical to PRIVATE unless a real isolation requirement lands;
# public delivery is always the same-origin /api/v1/dish-images route, never
# the bucket.
S3_BUCKET_MEDIA=feastjourney-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional Muse dish ranking (deterministic baseline when unset) ---
# Enabling requires provider=muse + server-side key + supported
# muse-spark-*/muse-wonder-* id + https base; misconfiguration fails
# loudly (HTTP 500). Server-side key only — never a browser key.
RECOMMENDATION_PROVIDER=deterministic
MODEL_API_KEY=
MODEL_MODEL_ID=muse-spark-1.3
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_TIMEOUT_MS=15000
MODEL_CANDIDATE_LIMIT=60
MODEL_OUTPUT_LIMIT=10
MODEL_MAX_TOKENS=4000
